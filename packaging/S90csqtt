#!/bin/sh
# CSQTT Entware manager. Device selection belongs to the native Keenetic policy.
PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077
DAEMON=/opt/bin/csqtt-entware
DAEMON_REAL=$(readlink -f "$DAEMON" 2>/dev/null || printf '%s' "$DAEMON")
RUNTIME=/tmp/csqtt
PIDFILE=$RUNTIME/manager.pid
SETTINGS=/opt/etc/csqtt/settings.json
LISTEN_FILE=/opt/etc/csqtt/listen

fail() { printf '%s\n' "CSQTT: $1" >&2; exit 1; }
ssd() {
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon "$@"
    elif /bin/busybox start-stop-daemon --help >/dev/null 2>&1; then
        /bin/busybox start-stop-daemon "$@"
    else
        return 127
    fi
}
running() {
    [ -d "$RUNTIME" ] && [ ! -L "$RUNTIME" ] || return 1
    [ "$(ls -nd "$RUNTIME" | awk '{print $3}')" = 0 ] || return 1
    [ -r "$PIDFILE" ] || return 1
    IFS= read -r manager_pid < "$PIDFILE" || return 1
    case "$manager_pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$(readlink "/proc/$manager_pid/exe" 2>/dev/null)" = "$DAEMON_REAL" ]
}
start() {
    running && return 0
    [ -x "$DAEMON" ] || fail 'manager binary is missing'
    [ -x /opt/bin/csqtt-client ] || fail 'transport binary is missing'
    [ ! -L /opt/etc/csqtt ] && [ ! -L "$RUNTIME" ] || fail 'private directory is a symlink'
    mkdir -p /opt/etc/csqtt "$RUNTIME" || fail 'cannot create private directories'
    for private_dir in /opt/etc/csqtt "$RUNTIME"; do
        [ "$(ls -nd "$private_dir" | awk '{print $3}')" = 0 ] || fail 'private directory has an unexpected owner'
    done
    chmod 700 /opt/etc/csqtt "$RUNTIME" || fail 'cannot protect private directories'
    listen=192.168.2.1:8080
    if [ -f "$LISTEN_FILE" ]; then IFS= read -r listen < "$LISTEN_FILE" || :; fi
    case "$listen" in ''|*[!0-9.:]*) fail 'invalid listener setting' ;; esac
    # Runtime stdout is discarded: neither upstream diagnostics nor credentials
    # can accumulate in an unbounded USB log. The UI exposes redacted status.
    ssd -S -b -m -p "$PIDFILE" -x "$DAEMON" -- \
        --listen "$listen" --config "$SETTINGS" --runtime "$RUNTIME" \
        --core /opt/bin/csqtt-client </dev/null >/dev/null 2>&1 || fail 'start failed'
    sleep 1
    running || fail 'manager exited during startup'
    command -v logger >/dev/null 2>&1 && logger -t csqtt-entware 'manager started'
    return 0
}
stop() {
    if running; then
        ssd -K -s TERM -p "$PIDFILE" -x "$DAEMON" >/dev/null 2>&1 || fail 'stop failed'
        remaining=20
        while running && [ "$remaining" -gt 0 ]; do
            sleep 1
            remaining=$((remaining - 1))
        done
        if running; then
            # PID and executable are checked again by start-stop-daemon.
            ssd -K -s KILL -p "$PIDFILE" -x "$DAEMON" >/dev/null 2>&1 || fail 'forced stop failed'
            sleep 1
        fi
        running && fail 'manager is still running'
    fi
    rm -f "$PIDFILE"
    command -v logger >/dev/null 2>&1 && logger -t csqtt-entware 'manager stopped'
    return 0
}
case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    status) if running; then printf '%s\n' 'CSQTT manager is running'; else printf '%s\n' 'CSQTT manager is stopped'; exit 1; fi ;;
    *) printf '%s\n' 'Usage: S90csqtt {start|stop|restart|status}' >&2; exit 2 ;;
esac
